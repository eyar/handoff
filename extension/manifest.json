{
  "manifest_version": 3,
  "name": "Handoff — Send to Phone",
  "short_name": "Handoff",
  "version": "0.1.1",
  "description": "Send text, links, images and files between Chrome and your phone. Scan a QR code — no app, no account, end-to-end encrypted.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Handoff",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["https://handoffdrop.app/*"],
  "commands": {
    "open-handoff": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Open Handoff"
    }
  }
}
